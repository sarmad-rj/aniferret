# Copy to .env and fill in real values. Never commit the real .env file.

APP_NAME=AniFerret
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

DATABASE_URL=sqlite+aiosqlite:///./aniferret.db

GEMINI_API_KEY=
CHROMA_PERSIST_DIR=./chroma_store

CORS_ORIGINS=["http://localhost:5173"]

# Required for stable login sessions across server restarts -- without this, a random
# secret is generated on every process start and all existing tokens are invalidated.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10080
